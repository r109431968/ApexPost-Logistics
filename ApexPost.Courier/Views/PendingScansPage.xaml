<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ApexPost.Courier.Views.PendingScansPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ApexPost.Courier.Views"
    xmlns:vm="clr-namespace:ApexPost.Courier.ViewModels"
    x:DataType="vm:PendingScansViewModel"
    Title="Pending Scans">
    <Grid RowDefinitions="Auto,Auto,*">
        <views:OfflineBanner Grid.Row="0" />
        <Label Grid.Row="1" Padding="16,12" Text="{Binding Summary}" FontAttributes="Bold" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Scans}">
            <CollectionView.EmptyView>
                <Label Text="Nothing waiting. Every scan has been sent." Padding="16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ScanRow">
                    <VerticalStackLayout Padding="16,8" Spacing="2">
                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                        <Label Text="{Binding Detail}" FontSize="13" />
                        <Label Text="{Binding Status}" FontSize="13" TextColor="{Binding StatusColor}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
