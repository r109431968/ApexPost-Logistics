<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ApexPost.Courier.Views.OfflineBanner"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:ApexPost.Courier.Core.Resilience;assembly=ApexPost.Courier.Core"
    x:DataType="res:ConnectionStatus">
    <Border IsVisible="{Binding IsServerUnavailable}" BackgroundColor="#B3261E" StrokeThickness="0" Padding="12,8">
        <Label Text="{Binding BannerText}" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center" />
    </Border>
</ContentView>
