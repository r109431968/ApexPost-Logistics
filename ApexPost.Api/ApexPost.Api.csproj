<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- The same secrets store as ApexPost.Web: the ConnectionStrings:ApexPostDb secret that is already set works here too. -->
    <UserSecretsId>apexpost-counter-platform-2026</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 = "missing XML comment". Every public controller action and DTO is documented; the rest is not published. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Application\ApexPost.Application.csproj" />
    <ProjectReference Include="..\ApexPost.Infrastructure\ApexPost.Infrastructure.csproj" />
  </ItemGroup>
</Project>
