{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",

  "Storage": { "DataDirectory": "data" },

  "Shipping": {
    "MaxLetterKg": 2,
    "MaxStandardParcelKg": 30,
    "MaxExpressParcelKg": 20,
    "MaxRegisteredParcelKg": 10,
    "StandardMultiplier": 1.0,
    "ExpressMultiplier": 1.6,
    "RegisteredMultiplier": 1.3
  },
  "Tax": { "StandardRate": 0.20, "ReducedRate": 0.05 },
  "MoneyOrders": {
    "IdentityVerificationThreshold": 300,
    "HighValueAlertThreshold": 1000,
    "FeePercent": 0.02,
    "MinimumFee": 2
  },
  "Stock": { "LowStockThreshold": 5 },
  "Passwords": { "Iterations": 600000 },
  "Courier": {
    "MaxConcurrentLookups": 3,
    "TimeoutMilliseconds": 2000,
    "SimulatedLatencyMilliseconds": 150
  },
  "Catalog": { "TimeToLiveSeconds": 300 },
  "Seed": { "Enabled": true },

  "Security": {
    "AdminAllowedIps": [ "127.0.0.1", "::1" ],
    "IntegrationAllowedIps": [ "127.0.0.1", "::1" ],
    "PartnerWidgetOrigins": [ "https://tracking.partner.example" ]
  },
  "Maintenance": { "Enabled": false, "RetryAfterSeconds": 120 },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "PartnerPermitLimit": 30,
    "PartnerWindowSeconds": 60
  },
  "Performance": { "SlowActionMs": 500 }
}
