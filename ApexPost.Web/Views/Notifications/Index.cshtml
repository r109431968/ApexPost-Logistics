@model IReadOnlyList<Notification>
@{
    ViewData["Title"] = "Notifications";
}
<h1>Notifications <span class="muted">(simulated)</span></h1>
@if (Model.Count == 0)
{
    <p class="muted">No notifications yet. Sell something that empties a shelf, or void a transaction.</p>
}
else
{
    <table>
        <thead><tr><th>When</th><th>Kind</th><th>Title</th><th>Message</th></tr></thead>
        <tbody>
        @foreach (var note in Model)
        {
            <tr><td>@Fmt.When(note.At)</td><td>@note.Kind</td><td>@note.Title</td><td>@note.Message</td></tr>
        }
        </tbody>
    </table>
}
