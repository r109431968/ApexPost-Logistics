@model MoneyOrderAuditViewModel
@{
    ViewData["Title"] = "Money orders";
}
<h1>Money orders and identity verifications</h1>
<form method="get" class="filters" asp-controller="Reports" asp-action="MoneyOrders">
    <partial name="_BranchFilter" model="Model.Filter" />
    <button type="submit">Show</button>
</form>
@foreach (var summary in Model.Summaries)
{
    <section class="card">
        <h2>@summary.BranchCode</h2>
        <p>
            Paid money orders: <strong>@summary.PaidMoneyOrderCount</strong> totalling <strong>@Fmt.Price(summary.PaidTotalAmount)</strong>.
            Verifications passed: <strong>@summary.VerificationsPassed</strong>, failed: <strong>@summary.VerificationsFailed</strong>.
        </p>
        @if (summary.Rows.Count > 0)
        {
            <table>
                <thead><tr><th>When</th><th>Status</th><th class="num">Amount</th><th class="num">Fee</th><th>Document</th><th>Result</th></tr></thead>
                <tbody>
                @foreach (var row in summary.Rows)
                {
                    <tr>
                        <td>@Fmt.When(row.At)</td>
                        <td>@row.Status</td>
                        <td class="num">@Fmt.Price(row.Amount)</td>
                        <td class="num">@Fmt.Price(row.Fee)</td>
                        <td>@row.DocumentType @row.MaskedDocumentNumber</td>
                        <td>@row.VerificationResult</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
}
