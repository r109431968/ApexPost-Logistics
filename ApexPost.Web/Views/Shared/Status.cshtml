@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<section class="card narrow">
    <h1>@Model.Code &ndash; @Model.Title</h1>
    <p>@Model.Message</p>
    <p class="muted">Trace ID: @Model.TraceId<br />Correlation ID: @Model.CorrelationId</p>
    <p><a asp-controller="Home" asp-action="Index">Back to the start</a></p>
</section>
